<?xml version="1.0" encoding="utf-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <xs:include schemaLocation="def_cliente.xsd"/>
  <xs:include schemaLocation="def_dati_tecnici.xsd"/>
  <xs:include schemaLocation="def_documentazione.xsd"/>
  <xs:include schemaLocation="def_identificativi.xsd"/>
  <xs:include schemaLocation="def_main_types.xsd"/>
  <xs:element name="FlussoMisure">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="IdentificativiFlusso" type="IdentificativiRichiestaBase"/>
        <xs:element name="DatiPdr" maxOccurs="unbounded">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="cod_pdr" type="CodicePdr"/>
              <xs:element name="mese_comp" type="MeseAnnoItaType" minOccurs="0"/>
              <xs:element name="data_comp" type="DataIta" minOccurs="0"/>
              <xs:element name="tipo_rettifica" type="TipoRettifica"/>
              <xs:element name="mot_ret_lett" type="MotivazioneRettLettura"/>
			  <xs:element name="causa_ostativa" type="OnOff" minOccurs="0"/>
              <xs:element name="data_prest" type="DataIta" minOccurs="0"/>
              <xs:element name="CodPrat_SII" type="CodPratAtt" minOccurs="0"/>
              <xs:element name="DatiTecnPdrRett" type="DatiTecniciPdrRett"/>
              <xs:choice minOccurs="0">
                <xs:element name="DatiLetturaRett" type="DettaglioDatiLetturaRett" />
                <xs:element name="LettureGiornaliereRett" type="DettaglioLettureGiornaliereRett" maxOccurs="unbounded" />
              </xs:choice>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
      <xs:attribute name="cod_flusso" type="TipoCodFlussoRGASType" use="required" />
    </xs:complexType>
  </xs:element>
</xs:schema>
