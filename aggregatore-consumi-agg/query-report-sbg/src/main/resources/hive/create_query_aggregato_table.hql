create external table ${agg.db}.query_aggregato_sbg
( pdr string,
  piva_distr string,
  piva_it string,
  piva_udd string,
  piva_udb string,
  piva_rdb string,
  dtg string,
  cod_remi string,
  id_reg_clim int,
  cod_prof_prel_std string,
  trattamento string,
  tipo_cliente string,
  unit_mis_prel string,
  data_val string,
  prelievo_giorn_1 int,
  prelievo_giorn_2 int,
  prelievo_giorn_3 int,
  prelievo_giorn_4 int,
  prelievo_giorn_5 int,
  prelievo_giorn_6 int,
  prelievo_giorn_7 int,
  prelievo_giorn_8 int,
  prelievo_giorn_9 int,
  prelievo_giorn_10 int,
  prelievo_giorn_11 int,
  prelievo_giorn_12 int,
  prelievo_giorn_13 int,
  prelievo_giorn_14 int,
  prelievo_giorn_15 int,
  prelievo_giorn_16 int,
  prelievo_giorn_17 int,
  prelievo_giorn_18 int,
  prelievo_giorn_19 int,
  prelievo_giorn_20 int,
  prelievo_giorn_21 int,
  prelievo_giorn_22 int,
  prelievo_giorn_23 int,
  prelievo_giorn_24 int,
  prelievo_giorn_25 int,
  prelievo_giorn_26 int,
  prelievo_giorn_27 int,
  prelievo_giorn_28 int,
  prelievo_giorn_29 int,
  prelievo_giorn_30 int,
  prelievo_giorn_31 int,
  dailyconsumption_executionid bigint,
  annomese string
) partitioned by (executionid bigint)
stored as parquet
location '${hdfs.basePath}/query_aggregato'
