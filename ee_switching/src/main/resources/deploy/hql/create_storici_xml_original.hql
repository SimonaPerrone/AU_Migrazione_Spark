             b.raccolta,
             b.racc_next) NOT IN
    ( SELECT concat(pod14,data_misura,d_next,raccolta,racc_next)
     FROM sos_202011_202012.sw_misure_no_12m_202002_delta_e_s
     WHERE raccolta = 'T'
       AND racc_next = 'T') ;

*/
