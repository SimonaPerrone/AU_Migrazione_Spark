SET DATA=to_date(from_unixtime(unix_timestamp('01/11/2020','dd/MM/yyyy')));


DROP TABLE sos_202011_202012.sw_misure_no_12m_202002_delta;


CREATE TABLE sos_202011_202012.sw_misure_no_12m_202002_delta stored AS parquet AS
SELECT zzz.*,
       CASE
           WHEN last_nomefile LIKE '%2G%' THEN 'S2G'
           WHEN (last_nomefile NOT LIKE '%2G%'
                 AND TRATTAMENTO_ONLINE !='O') THEN 'SNS'
           WHEN (last_nomefile NOT LIKE '%2G%'
                 AND TRATTAMENTO_ONLINE ='O') THEN 'SOS'
           ELSE 'XXX'
       END NOME_FLUSSO ,
       CASE
           WHEN last_nomefile_MESE LIKE '%\_R.%' THEN 'SI'
           ELSE 'NO'
       END MESSA_REGIME --, case when last_nomefile_MESE like '%2G%' then 'G' else 'E' END TIPO_MISURATORE
 --, case when last_nomefile_MESE like '%2G%' then 'G' when last_nomefile_MESE NOT like '%2G%' AND last_TIPO_MISURATORE_MIS_MESE IS NOT NULL THEN last_TIPO_MISURATORE_MIS_MESE else 'E' END TIPO_MISURATORE ----PER GESTIRE GLI SMIS 2G
 ,
       CASE
           WHEN last_nomefile_MESE LIKE '%2G%' THEN 'G'
           WHEN last_nomefile_MESE NOT LIKE '%2G%'
                AND last_TIPO_MISURATORE_MIS_MESE IS NOT NULL THEN last_TIPO_MISURATORE_MIS_MESE
           WHEN last_nomefile_MESE NOT LIKE '%2G%'
                AND last_TIPO_MISURATORE_MIS_MESE IS NULL
                AND (delta_eaf1 IS NOT NULL
                     OR delta_eaf2 IS NOT NULL
                     OR delta_eaf3 IS NOT NULL) THEN 'E'
           WHEN last_nomefile_MESE NOT LIKE '%2G%'
                AND last_TIPO_MISURATORE_MIS_MESE IS NULL
                AND (delta_eam IS NOT NULL) THEN 'T'
           ELSE 'E'
       END TIPO_MISURATORE ----nuovo da testare

FROM (
SELECT zz.* ,
       last_value(next_potf1) over(partition BY pod14,
                                                anno_misura_next,
                                                mese_misura_next,
                                                annomese_sw
                                   ORDER BY to_date(from_unixtime(unix_timestamp(d_next,'dd/MM/yyyy'))) ASC ROWS BETWEEN unbounded preceding AND unbounded following) AS last_potf1 ,
                                  last_value(next_potf2) over(partition BY pod14,
                                                                           anno_misura_next,
                                                                           mese_misura_next,
                                                                           annomese_sw
                                                              ORDER BY to_date(from_unixtime(unix_timestamp(d_next,'dd/MM/yyyy'))) ASC ROWS BETWEEN unbounded preceding AND unbounded following) AS last_potf2 ,
                                                             last_value(next_potf3) over(partition BY pod14,
                                                                                                      anno_misura_next,
                                                                                                      mese_misura_next,
                                                                                                      annomese_sw
                                                                                         ORDER BY to_date(from_unixtime(unix_timestamp(d_next,'dd/MM/yyyy'))) ASC ROWS BETWEEN unbounded preceding AND unbounded following) AS last_potf3 ,
                                                                                        last_value(next_potf4) over(partition BY pod14,
                                                                                                                                 anno_misura_next,
                                                                                                                                 mese_misura_next,
                                                                                                                                 annomese_sw
                                                                                                                    ORDER BY to_date(from_unixtime(unix_timestamp(d_next,'dd/MM/yyyy'))) ASC ROWS BETWEEN unbounded preceding AND unbounded following) AS last_potf4 ,
                                                                                                                   last_value(next_potf5) over(partition BY pod14,
                                                                                                                                                            anno_misura_next,
                                                                                                                                                            mese_misura_next,
                                                                                                                                                            annomese_sw
                                                                                                                                               ORDER BY to_date(from_unixtime(unix_timestamp(d_next,'dd/MM/yyyy'))) ASC ROWS BETWEEN unbounded preceding AND unbounded following) AS last_potf5 ,
                                                                                                                                              last_value(next_potf6) over(partition BY pod14,
                                                                                                                                                                                       anno_misura_next,
                                                                                                                                                                                       mese_misura_next,
                                                                                                                                                                                       annomese_sw
                                                                                                                                                                          ORDER BY to_date(from_unixtime(unix_timestamp(d_next,'dd/MM/yyyy'))) ASC ROWS BETWEEN unbounded preceding AND unbounded following) AS last_potf6 ,
                                                                                                                                                                         last_value(next_potmax) over(partition BY pod14,
                                                                                                                                                                                                                   anno_misura_next,
                                                                                                                                                                                                                   mese_misura_next,
                                                                                                                                                                                                                   annomese_sw
                                                                                                                                                                                                      ORDER BY to_date(from_unixtime(unix_timestamp(d_next,'dd/MM/yyyy'))) ASC ROWS BETWEEN unbounded preceding AND unbounded following) AS last_potmax --,last_value(next_tipodato_e) over(partition by pod14, anno_misura_next, mese_misura_next,annomese_sw order by to_date(from_unixtime(unix_timestamp(d_next,'dd/MM/yyyy'))) asc rows between unbounded preceding and unbounded following) as last_tipodato_e
 --,last_value(next_tipodato_s) over(partition by pod14, anno_misura_next, mese_misura_next,annomese_sw order by to_date(from_unixtime(unix_timestamp(d_next,'dd/MM/yyyy'))) asc rows between unbounded preceding and unbounded following) as last_tipodato_s
 ,
                                                                                                                                                                                                     last_value(tipodato_e_str_case) over(partition BY pod14,
                                                                                                                                                                                                                                                       anno_misura_next,
                                                                                                                                                                                                                                                       mese_misura_next,
                                                                                                                                                                                                                                                       annomese_sw
                                                                                                                                                                                                                                          ORDER BY tipodato_e_str_case ASC ROWS BETWEEN unbounded preceding AND unbounded following) AS last_tipodato_e ,
                                                                                                                                                                                                                                         last_value(tipodato_s_str_case) over(partition BY pod14,
                                                                                                                                                                                                                                                                                           anno_misura_next,
                                                                                                                                                                                                                                                                                           mese_misura_next,
                                                                                                                                                                                                                                                                                           annomese_sw
                                                                                                                                                                                                                                                                              ORDER BY tipodato_s_str_case ASC ROWS BETWEEN unbounded preceding AND unbounded following) AS last_tipodato_s ,
                                                                                                                                                                                                                                                                             last_value(trattamento_misura) over(partition BY pod14,
                                                                                                                                                                                                                                                                                                                              anno_misura_next,
                                                                                                                                                                                                                                                                                                                              mese_misura_next,
                                                                                                                                                                                                                                                                                                                              annomese_sw
                                                                                                                                                                                                                                                                                                                 ORDER BY to_date(from_unixtime(unix_timestamp(d_next,'dd/MM/yyyy'))) ASC ROWS BETWEEN unbounded preceding AND unbounded following) AS trattamento ,
                                                                                                                                                                                                                                                                                                                last_value(next_nomefile) over(partition BY pod14,
                                                                                                                                                                                                                                                                                                                                                            anno_misura_next,
                                                                                                                                                                                                                                                                                                                                                            mese_misura_next,
                                                                                                                                                                                                                                                                                                                                                            annomese_sw
                                                                                                                                                                                                                                                                                                                                               ORDER BY to_date(from_unixtime(unix_timestamp(d_next,'dd/MM/yyyy'))) ASC ROWS BETWEEN unbounded preceding AND unbounded following) AS last_nomefile_MESE ,
                                                                                                                                                                                                                                                                                                                                              last_value(TIPO_MISURATORE_MIS) over(partition BY pod14,
                                                                                                                                                                                                                                                                                                                                                                                                anno_misura_next,
                                                                                                                                                                                                                                                                                                                                                                                                mese_misura_next,
                                                                                                                                                                                                                                                                                                                                                                                                annomese_sw
                                                                                                                                                                                                                                                                                                                                                                                   ORDER BY to_date(from_unixtime(unix_timestamp(d_next,'dd/MM/yyyy'))) ASC ROWS BETWEEN unbounded preceding AND unbounded following) AS last_TIPO_MISURATORE_MIS_MESE ,
                                                                                                                                                                                                                                                                                                                                                                                  last_value(next_nomefile) over(partition BY pod14,
                                                                                                                                                                                                                                                                                                                                                                                                                              annomese_sw
                                                                                                                                                                                                                                                                                                                                                                                                                 ORDER BY to_date(from_unixtime(unix_timestamp(d_next,'dd/MM/yyyy'))) ASC ROWS BETWEEN unbounded preceding AND unbounded following) AS last_nomefile
FROM
  ( SELECT LL.*,
           CASE
               WHEN ((motivazione IN ('4',
                                      '5')
                      AND nvl(motivazione_next,'X') NOT IN ('4',
                                                            '5'))
                     AND nvl(trattamento_misura,'X')!='O') THEN 0
               WHEN --!!AND DATA_INIZIO_PERIODO IS NOT NULL)----VERIFICARE SE VA CON POD IT001E04668989 ---SUL POD IT001E91876859 IL TRATTAMENTO E' F MA INVIANO I TOTALIZZATORI, ANCHE SU IT001E97296021----
 ((motivazione_next IN ('4',
                        '5')
   OR motivazione IN ('4',
                      '5'))
  AND nvl(trattamento_misura,'X')!='O') THEN next_eaf1
               ELSE next_eaf1-eaf1
           END delta_eaf1,
           CASE
               WHEN ((motivazione IN ('4',
                                      '5')
                      AND nvl(motivazione_next,'X') NOT IN ('4',
                                                            '5'))
                     AND nvl(trattamento_misura,'X')!='O') THEN 0
               WHEN ((motivazione_next IN ('4',
                                           '5')
                      OR motivazione IN ('4',
                                         '5'))
                     AND nvl(trattamento_misura,'X')!='O') THEN next_eaf2
               ELSE next_eaf2-eaf2
           END delta_eaf2,
           CASE
               WHEN ((motivazione IN ('4',
                                      '5')
                      AND nvl(motivazione_next,'X') NOT IN ('4',
                                                            '5'))
                     AND nvl(trattamento_misura,'X')!='O') THEN 0
               WHEN ((motivazione_next IN ('4',
                                           '5')
                      OR motivazione IN ('4',
                                         '5'))
                     AND nvl(trattamento_misura,'X')!='O') THEN next_eaf3
               ELSE next_eaf3-eaf3
           END delta_eaf3 ,
           next_eaf4-eaf4 AS delta_eaf4 ,
           next_eaf5-eaf5 AS delta_eaf5 ,
           next_eaf6-eaf6 AS delta_eaf6 ,
           next_eam-eam AS delta_eam ,
           CASE
               WHEN ((motivazione IN ('4',
                                      '5')
                      AND nvl(motivazione_next,'X') NOT IN ('4',
                                                            '5'))
                     AND nvl(trattamento_misura,'X')!='O') THEN 0
               ELSE datediff(to_date(from_unixtime(unix_timestamp(d_next,'dd/MM/yyyy'))), to_date(from_unixtime(unix_timestamp(DATA_MISURA,'dd/MM/yyyy'))))
           END giorni,
           YEAR(to_date(from_unixtime(unix_timestamp(DATA_MISURA,'dd/MM/yyyy')))) AS anno_misura,
           month(to_date(from_unixtime(unix_timestamp(DATA_MISURA,'dd/MM/yyyy')))) AS mese_misura,
           YEAR(to_date(from_unixtime(unix_timestamp(d_next,'dd/MM/yyyy')))) AS anno_misura_next,
           month(to_date(from_unixtime(unix_timestamp(d_next,'dd/MM/yyyy')))) AS mese_misura_next
   FROM
     ( SELECT OOO.*,
              CASE
                  WHEN tipodato_e_str = 'S'
                       OR next_tipodato_e_str = 'S' THEN 'S'
                  ELSE 'E'
              END tipodato_e_str_case,
              CASE
                  WHEN tipodato_s_str = 'S'
                       OR next_tipodato_s_str = 'S' THEN 'S'
                  ELSE 'E'
              END tipodato_s_str_case
      FROM
        ( SELECT X.*,
                 lag(X.EAF1, 1, 0) over (partition BY x.pod14,x.annomese_sw
                                         ORDER BY to_date(from_unixtime(unix_timestamp(X.DATA_MISURA,'dd/MM/yyyy')))) AS previous_eaf1 ,
                 lead(X.EAF1, 1, 0) over (partition BY x.pod14,x.annomese_sw
                                          ORDER BY to_date(from_unixtime(unix_timestamp(X.DATA_MISURA,'dd/MM/yyyy')))) AS next_eaf1 ,
                 lag(X.EAF2, 1, 0) over (partition BY x.pod14,x.annomese_sw
                                         ORDER BY to_date(from_unixtime(unix_timestamp(X.DATA_MISURA,'dd/MM/yyyy')))) AS previous_eaf2 ,
                 lead(X.EAF2, 1, 0) over (partition BY x.pod14,x.annomese_sw
                                          ORDER BY to_date(from_unixtime(unix_timestamp(X.DATA_MISURA,'dd/MM/yyyy')))) AS next_eaf2 ,
                 lag(X.EAF3, 1, 0) over (partition BY x.pod14,x.annomese_sw
                                         ORDER BY to_date(from_unixtime(unix_timestamp(X.DATA_MISURA,'dd/MM/yyyy')))) AS previous_eaf3 ,
                 lead(X.EAF3, 1, 0) over (partition BY x.pod14,x.annomese_sw
                                          ORDER BY to_date(from_unixtime(unix_timestamp(X.DATA_MISURA,'dd/MM/yyyy')))) AS next_eaf3 ,
                 lag(X.EAF4, 1, 0) over (partition BY x.pod14,x.annomese_sw
                                         ORDER BY to_date(from_unixtime(unix_timestamp(X.DATA_MISURA,'dd/MM/yyyy')))) AS previous_eaf4 ,
                 lead(X.EAF4, 1, 0) over (partition BY x.pod14,x.annomese_sw
                                          ORDER BY to_date(from_unixtime(unix_timestamp(X.DATA_MISURA,'dd/MM/yyyy')))) AS next_eaf4 ,
                 lag(X.EAF5, 1, 0) over (partition BY x.pod14,x.annomese_sw
                                         ORDER BY to_date(from_unixtime(unix_timestamp(X.DATA_MISURA,'dd/MM/yyyy')))) AS previous_eaf5 ,
                 lead(X.EAF5, 1, 0) over (partition BY x.pod14,x.annomese_sw
                                          ORDER BY to_date(from_unixtime(unix_timestamp(X.DATA_MISURA,'dd/MM/yyyy')))) AS next_eaf5 ,
                 lag(X.EAF6, 1, 0) over (partition BY x.pod14,x.annomese_sw
                                         ORDER BY to_date(from_unixtime(unix_timestamp(X.DATA_MISURA,'dd/MM/yyyy')))) AS previous_eaf6 ,
                 lead(X.EAF6, 1, 0) over (partition BY x.pod14,x.annomese_sw
                                          ORDER BY to_date(from_unixtime(unix_timestamp(X.DATA_MISURA,'dd/MM/yyyy')))) AS next_eaf6 ,
                 lag(X.EAM, 1, 0) over (partition BY x.pod14,x.annomese_sw
                                        ORDER BY to_date(from_unixtime(unix_timestamp(X.DATA_MISURA,'dd/MM/yyyy')))) AS previous_eam ,
                 lead(X.EAM, 1, 0) over (partition BY x.pod14,x.annomese_sw
                                         ORDER BY to_date(from_unixtime(unix_timestamp(X.DATA_MISURA,'dd/MM/yyyy')))) AS next_eam ,
                 lead(x.data_misura, 1, 0) over (partition BY x.pod14,x.annomese_sw
                                                 ORDER BY to_date(from_unixtime(unix_timestamp(x.DATA_MISURA,'dd/MM/yyyy')))) AS d_next ,
                 lead(x.raccolta, 1, 0) over (partition BY x.pod14,x.annomese_sw
                                              ORDER BY to_date(from_unixtime(unix_timestamp(x.DATA_MISURA,'dd/MM/yyyy')))) AS racc_next ,
                 lead(X.potf1, 1, 0) over (partition BY x.pod14,x.annomese_sw
                                           ORDER BY to_date(from_unixtime(unix_timestamp(X.DATA_MISURA,'dd/MM/yyyy')))) AS next_potf1 ,
                 lead(X.potf2, 1, 0) over (partition BY x.pod14,x.annomese_sw
                                           ORDER BY to_date(from_unixtime(unix_timestamp(X.DATA_MISURA,'dd/MM/yyyy')))) AS next_potf2 ,
                 lead(X.potf3, 1, 0) over (partition BY x.pod14,x.annomese_sw
                                           ORDER BY to_date(from_unixtime(unix_timestamp(X.DATA_MISURA,'dd/MM/yyyy')))) AS next_potf3 ,
                 lead(X.potf4, 1, 0) over (partition BY x.pod14,x.annomese_sw
                                           ORDER BY to_date(from_unixtime(unix_timestamp(X.DATA_MISURA,'dd/MM/yyyy')))) AS next_potf4 ,
                 lead(X.potf5, 1, 0) over (partition BY x.pod14,x.annomese_sw
                                           ORDER BY to_date(from_unixtime(unix_timestamp(X.DATA_MISURA,'dd/MM/yyyy')))) AS next_potf5 ,
                 lead(X.potf6, 1, 0) over (partition BY x.pod14,x.annomese_sw
                                           ORDER BY to_date(from_unixtime(unix_timestamp(X.DATA_MISURA,'dd/MM/yyyy')))) AS next_potf6 ,
                 lead(X.potmax, 1, 0) over (partition BY x.pod14,x.annomese_sw
                                            ORDER BY to_date(from_unixtime(unix_timestamp(X.DATA_MISURA,'dd/MM/yyyy')))) AS next_potmax ,
                 lead(X.tipodato_e, 1, 0) over (partition BY x.pod14,x.annomese_sw
                                                ORDER BY to_date(from_unixtime(unix_timestamp(X.DATA_MISURA,'dd/MM/yyyy')))) AS next_tipodato_e ,
                 lead(X.tipodato_s, 1, 0) over (partition BY x.pod14,x.annomese_sw
                                                ORDER BY to_date(from_unixtime(unix_timestamp(X.DATA_MISURA,'dd/MM/yyyy')))) AS next_tipodato_s ,
                 lead(X.tipodato_e_str, 1, 0) over (partition BY x.pod14,x.annomese_sw
                                                    ORDER BY to_date(from_unixtime(unix_timestamp(X.DATA_MISURA,'dd/MM/yyyy')))) AS next_tipodato_e_str ,
                 lead(X.tipodato_s_str, 1, 0) over (partition BY x.pod14,x.annomese_sw
                                                    ORDER BY to_date(from_unixtime(unix_timestamp(X.DATA_MISURA,'dd/MM/yyyy')))) AS next_tipodato_s_str ,
                 lead(X.nomefile, 1, 0) over (partition BY x.pod14,x.annomese_sw
                                              ORDER BY to_date(from_unixtime(unix_timestamp(X.DATA_MISURA,'dd/MM/yyyy')))) AS next_nomefile ,
                 lead(X.motivazione, 1, 0) over (partition BY x.pod14,x.annomese_sw
                                                 ORDER BY time_stamp) AS MOT3_motivazione_next ---SE LA MOTIVAZIONE NEXT E' UNA MOTIVAZIONE 3 DEVO ELIMINARE QUEL RECORD
 ,
                 lead(X.motivazione, 1, 0) over (partition BY x.pod14,x.annomese_sw
                                                 ORDER BY to_date(from_unixtime(unix_timestamp(X.DATA_MISURA,'dd/MM/yyyy')))) AS motivazione_next
         FROM
           (SELECT DISTINCT *
            FROM
              ( SELECT uu.*,
                       CASE
                           WHEN tipodato_S = 1 THEN 'S'
                           ELSE 'E'
                       END tipodato_e_str,
                       CASE
                           WHEN tipodato_S = 0 THEN 'E'
                           ELSE 'S'
                       END tipodato_S_str
               FROM sos_202010_202011.sw_misure_no_12m_202002_rak_P_ATT uu )UUU ) X --) ll) zz where giorni is not null and giorni > 0)zzz;
 --) ll) zz where (giorni is not null and giorni > 0) or (giorni is null and to_date(from_unixtime(unix_timestamp(DATA_MISURA,'dd/MM/yyyy')))=last_day(add_months(${hiveconf:Data},-1))) )zzz;
 )OOO ll) zz
   WHERE (giorni IS NOT NULL
          AND giorni > 0)
     OR (giorni IS NULL
         AND to_date(from_unixtime(unix_timestamp(DATA_MISURA,'dd/MM/yyyy')))==date_sub(${hiveconf:Data},1))
     OR (giorni IS NULL
         AND to_date(from_unixtime(unix_timestamp(DATA_MISURA,'dd/MM/yyyy')))==date_sub(add_months(${hiveconf:Data},-1),1))
     OR ( giorni IS NULL
         AND to_date(from_unixtime(unix_timestamp(DATA_MISURA,'dd/MM/yyyy')))==add_months(date_sub(trunc(to_date(from_unixtime(unix_timestamp(DATA_MISURA,'dd/MM/yyyy'))), 'MM'),1) ,+1) ---L'ULTIMOD DEL MESE DI OGNI DATAMISURA---
 ) )zzz;


---FASE DI INTEGRAZIONE CON DATI RCU---
 ---CON DATI RCU SIA TRATTAMENTO CHE TIPO MISURATORE, TABELLE CARICATE CON SQOOP SW_CON_TRA_VIEW_RS_TRATT,sw_con_tra_view_rs_misur

DROP TABLE sos_202011_202012.sw_misure_no_12m_202002_delta_rcu_all;


CREATE TABLE sos_202011_202012.sw_misure_no_12m_202002_delta_rcu_all stored AS parquet AS WITH trattamento_rcu AS
  ( SELECT DISTINCT pod14,
                    trattamento AS trattamento_rcu,
                    year(TO_DATE(from_unixtime(UNIX_TIMESTAMP(nvl(anno_mese_calc,'1492-12-31 00:00:00.0'), 'yyyy-MM-dd HH:mm:ss.SSS')))) annotrattamento,
                    month(TO_DATE(from_unixtime(UNIX_TIMESTAMP(nvl(anno_mese_calc,'1492-12-31 00:00:00.0'), 'yyyy-MM-dd HH:mm:ss.SSS')))) mesetrattamento
   FROM sos_202011_202012.SW_CON_TRA_VIEW_RS_TRATT ),
                                                                                               misuratore_rcu AS
  ( SELECT DISTINCT pod14,
                    regexp_replace(tipo_misuratore,'O','E')AS tipo_misuratore_rcu,
                    year(TO_DATE(from_unixtime(UNIX_TIMESTAMP(nvl(anno_mese_calc,'1492-12-31 00:00:00.0'), 'yyyy-MM-dd HH:mm:ss.SSS')))) annomisuratore,
                    month(TO_DATE(from_unixtime(UNIX_TIMESTAMP(nvl(anno_mese_calc,'1492-12-31 00:00:00.0'), 'yyyy-MM-dd HH:mm:ss.SSS')))) mesemisuratore
   FROM sos_202011_202012.sw_con_tra_view_rs_misur )
SELECT x.*,
       y.tipo_misuratore_rcu,
       z.trattamento_rcu
FROM sos_202011_202012.sw_misure_no_12m_202002_delta x
LEFT OUTER JOIN misuratore_rcu y ON x.pod14=y.pod14
AND x.ANNO_MISURA_NEXT=y.annomisuratore
AND x.mese_MISURA_NEXT=y.mesemisuratore
LEFT OUTER JOIN trattamento_rcu z ON x.pod14=z.pod14
AND x.ANNO_MISURA_NEXT=z.annotrattamento
AND x.mese_MISURA_NEXT=z.mesetrattamento;

