---PULIZIA MOTIVAZIONE 3---LA MOTIVAZIONE 3 CANCELLA IL PRECEDENTE FLUSSO

DROP TABLE sos_202011_202012.sw_misure_no_12m_202002_MOT3;


CREATE TABLE sos_202011_202012.sw_misure_no_12m_202002_MOT3 AS
SELECT DISTINCT *
FROM sos_202011_202012.sw_misure_no_12m_202002_unionall b
WHERE ----aggiunta la distinct
 concat(b.pod14,
        b.mese,
        b.anno,
        b.time_stamp,
        b.nomefile) NOT IN
    ( SELECT concat(pod14,mese,anno,time_stamp,nomefile)
     FROM
       ( SELECT x.*,
                nvl(lead(X.motivazione, 1, 0) over (partition BY x.pod14, x.anno, x.mese, x.annomese_sw
                                                    ORDER BY time_stamp),99) AS MOT3_motivazione_next
        FROM sos_202011_202012.sw_misure_no_12m_202002_unionall x ) H
     WHERE mot3_motivazione_next=3 );

---- PULIZIA FLUSSI DOPPI, PROBLEMI IN FASE DI CARICAMENTO DEI FLUSSI---4 MINUTI

DROP TABLE sos_202011_202012.sw_misure_no_12m_202002_rak_P;


CREATE TABLE sos_202011_202012.sw_misure_no_12m_202002_rak_P stored AS parquet AS WITH sw_misure_no_12m_202002_rak AS ---- ELIMINO EVENTUALI DOPPI SMIS---2 MINUTI

  (SELECT b.*
   FROM
     (SELECT a.*,
             rank() over(partition BY pod14, data_misura
                         ORDER BY raccolta ASC) rak
      FROM sos_202011_202012.sw_misure_no_12m_202002_MOT3 a)b
   WHERE rak = 1)
SELECT ---pulisco le fasce doppie (errore di ingestione di Leonardo)
 x.pod14,
 x.data_misura,
 x.annomesegiornodir,
 x.eaf1,
 x.eaf2,
 x.eaf3,
