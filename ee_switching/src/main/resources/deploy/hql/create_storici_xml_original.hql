---VENGONO VERIFICATI I PERIODI DI ATTIVAZIONE DEL POD, SCARTANDO LE MISURE RIFERITE A MESI IN CUI IL POD NON E' ATTIVO SU RCU---SPOSTARE QUESTO ALL'INIZIO, IN FASE DI INGESTIONE DI MISURE???----

DROP TABLE sos_202011_202012.sw_misure_no_12m_202002_rak_P_ATT;


CREATE TABLE sos_202011_202012.sw_misure_no_12m_202002_rak_P_ATT AS
SELECT *
FROM
  (SELECT x.*,
          y.d_attivazione,
          y.d_disattivazione
   FROM sos_202011_202012.sw_misure_no_12m_202002_rak_P x,

     (SELECT pod14,
             d_attivazione,
             d_disattivazione
      FROM sos_202011_202012.SW_CON_TRA_VIEW_RS_M_ATT_T
      GROUP BY pod14,
               d_attivazione,
               d_disattivazione ) y
   WHERE to_date(from_unixtime(unix_timestamp(X.DATA_MISURA,'dd/MM/yyyy'))) BETWEEN TO_DATE(from_unixtime(UNIX_TIMESTAMP(nvl(y.D_attivazione,'1492-12-31 00:00:00.0'), 'yyyy-MM-dd HH:mm:ss.SSS'))) AND TO_DATE(from_unixtime(UNIX_TIMESTAMP(nvl(y.D_disattivazione,'2999-12-31 00:00:00.0'), 'yyyy-MM-dd HH:mm:ss.SSS')))
     AND x.pod14=y.pod14 )gg; --50 miliioni

