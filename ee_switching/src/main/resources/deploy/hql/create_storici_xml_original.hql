--- BUCHI INIT
---I BUCHI TAPPATI VANNO CREATI SULLA TABELLA PRIMA sos_202011_202012.sw_misure_no_12m_202002_delta_rcu_case E NON SU sos_202011_202012.sw_misure_no_12m_202002_delta_sm_A
---VERIFICA CHE IL NOMEFLUSSO SIA COERENTE CON L'ALTRA TABELLA----

DROP TABLE sos_202011_202012.DELTA_SALTO;


CREATE TABLE sos_202011_202012.DELTA_SALTO STORED AS PARQUET AS --2 minuti

SELECT X.*,
       abs(cast(months_between(trunc(to_date(from_unixtime(unix_timestamp(X.DATA_MISURA,'dd/MM/yyyy'))),'MM'), trunc(to_date(from_unixtime(unix_timestamp(X.D_next,'dd/MM/yyyy'))),'MM'))AS int)) AS delta_mesi
FROM sos_202011_202012.sw_misure_no_12m_202002_delta_sm_A X
WHERE ----sos_202011_202012.sw_misure_no_12m_202002_delta_rcu_case
 MONTH(to_date(from_unixtime(unix_timestamp(X.DATA_MISURA,'dd/MM/yyyy'))))!=MONTH(to_date(add_months(from_unixtime(unix_timestamp(X.D_next,'dd/MM/yyyy')),-1)))
  AND MONTH(to_date(from_unixtime(unix_timestamp(X.DATA_MISURA,'dd/MM/yyyy'))))!=MONTH(to_date(from_unixtime(unix_timestamp(X.D_next,'dd/MM/yyyy'))));

--			SELECT COUNT(*) FROM sos_202011_202012.DELTA_SALTO;
