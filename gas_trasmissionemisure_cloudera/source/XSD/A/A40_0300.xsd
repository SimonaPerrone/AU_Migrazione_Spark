<?xml version="1.0"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
	<xs:include schemaLocation="../def_dati_tecnici.xsd"/>
	<xs:include schemaLocation="../def_identificativi.xsd"/>
	<xs:include schemaLocation="../def_documentazione.xsd"/>
	<xs:element name="Prestazione">
		<xs:complexType>
			<xs:sequence>
				<xs:element name="IdentificativiRichiesta" type="IdentificativiRichiestaBase"/>
				<xs:element name="ClienteFinale" type="ClienteFinaleRecapito"/>
				<xs:element name="ServizioEnergetico" type="ServizioEnergetico"/>
				<xs:element name="Fornitura" type="FornituraUbic"/>
				<xs:element name="DatiTecnici" type="DatiTecniciPrelAtt"/>
				<xs:element name="IvaImposte" type="Imposte"/>
			</xs:sequence>
			<xs:attribute name="cod_servizio" type="xs:string" use="required" fixed="A40"/>
			<xs:attribute name="cod_flusso" type="xs:string" use="required" fixed="0300"/>
		</xs:complexType>
	</xs:element>
</xs:schema>
